# Make sure the Raspberry Pi hardware video drivers are loaded before Lex
# starts (bcm2835-codec occasionally fails its first probe with ENOMEM).
[Unit]
Description=Load Raspberry Pi hardware video codecs for Lex
After=systemd-modules-load.service
Before=lex.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'modprobe rpi_hevc_dec || true; for i in 1 2 3; do [ -e /dev/video11 ] && exit 0; modprobe -r bcm2835_codec; sleep 1; modprobe bcm2835_codec; sleep 2; done; exit 0'
# Quadlet generates lex.service very early in boot, before these drivers
# exist, and drops the optional (-) devices it can't find, so after a reboot
# Lex would run without hardware video. Regenerate it now that they're here.
ExecStartPost=/bin/sh -c 'if [ -e /dev/video10 ] && ! systemctl show -p ExecStart lex.service | grep -q /dev/video10; then systemctl daemon-reload; fi'

[Install]
WantedBy=multi-user.target
