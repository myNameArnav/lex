# Podman Quadlet unit for Lex on the Raspberry Pi (install to
# /etc/containers/systemd/). Paths inside the container match the host so the
# library media is available under /media. Adjust volumes and device groups
# for the destination host before installing.
[Unit]
Description=Lex media server (container)
After=network-online.target lex-hwcodec.service
Wants=network-online.target lex-hwcodec.service

[Container]
# Published image; `podman auto-update` (daily timer) pulls new releases and
# restarts Lex. Use localhost/lex:latest for images you build and load yourself.
Image=ghcr.io/mynamearnav/lex:latest
AutoUpdate=registry
ContainerName=lex
Network=host
User=1000:1000
GroupAdd=44
# Replace with the destination host's render group ID (getent group render).
GroupAdd=109
# "-" prefix: optional, so the container still starts (in software mode) if
# the codec drivers didn't load.
AddDevice=-/dev/video10
AddDevice=-/dev/video11
AddDevice=-/dev/video12
AddDevice=-/dev/video19
# The rest of bcm2835-codec (image_fx, encode_image): FFmpeg's HEVC decoder
# lookup opens every video node a media controller lists and gives up if
# one is missing.
AddDevice=-/dev/video18
AddDevice=-/dev/video31
AddDevice=-/dev/dri
AddDevice=-/dev/dma_heap
AddDevice=-/dev/vchiq
AddDevice=-/dev/vcio
# The HEVC decoder (/dev/video19) is found through the media controller and
# libudev; without these FFmpeg prints "Failed to find a device for V4L2 HEVC
# stateless" and decodes on the CPU. Normally media0 is rpi-hevc-dec and
# media1 bcm2835-codec, but the numbers follow driver load order (and reloads
# of bcm2835_codec), so a couple of spares are passed too. Owned by the video
# group (GroupAdd=44 above). Check: cat /sys/bus/media/devices/media*/model
AddDevice=-/dev/media0
AddDevice=-/dev/media1
AddDevice=-/dev/media2
AddDevice=-/dev/media3
Volume=/run/udev:/run/udev:ro
Volume=/srv/media:/media:ro
Volume=/var/lib/lex:/data
Environment=LEX_DATA=/data
Environment=LEX_ADDR=127.0.0.1:8420
Environment=TZ=Etc/UTC
HealthCmd=lex -healthcheck
HealthInterval=60s

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target default.target
